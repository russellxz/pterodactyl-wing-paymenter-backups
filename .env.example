# Copia este archivo a .env y edita los valores:  cp .env.example .env

# Puerto interno de la aplicación (Nginx hará proxy a este puerto)
PORT=3500

# Dirección donde escucha la app. Déjalo en 127.0.0.1 si usas Nginx en el mismo VPS.
HOST=127.0.0.1

# CLAVE SECRETA: cámbiala por un texto largo y aleatorio. Se usa para las sesiones
# y para cifrar las contraseñas SSH guardadas en la base de datos.
# Genera una con:  openssl rand -hex 32
APP_SECRET=cambia-esta-clave-por-una-aleatoria-larga

# Carpeta donde se guardan los .zip de las copias (opcional, por defecto ./storage/backups)
# BACKUP_DIR=/ruta/personalizada/backups
