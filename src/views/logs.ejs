<%- include('partials/head') %>

<header class="page-head">
  <h1>Logs</h1>
  <p>System activity and errors, in real time.</p>
</header>

<section class="card">
  <div class="toolbar">
    <span class="muted small">Showing the latest 300 entries. New ones appear at the top automatically.</span>
    <% if (admin.is_root) { %>
    <form method="post" action="/logs/clear" class="inline" data-confirm="Clear all log entries?">
      <button class="btn btn-sm btn-danger" type="submit"><i data-lucide="trash-2"></i>Clear logs</button>
    </form>
    <% } %>
  </div>

  <div class="logbox" id="logbox">
    <% if (!logs.length) { %>
    <p class="empty"><i data-lucide="inbox"></i>No log entries yet.</p>
    <% } %>
    <% logs.forEach(l => { %>
    <div class="log-line log-<%= l.level %>">
      <span class="log-time"><%= l.created_at %></span>
      <span class="log-level"><%= l.level %></span>
      <span class="log-msg"><%= l.message %></span>
    </div>
    <% }) %>
  </div>
</section>

<%- include('partials/foot') %>
