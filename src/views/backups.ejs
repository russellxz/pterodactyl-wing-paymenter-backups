<%- include('partials/head') %>

<header class="page-head">
  <h1>Backups</h1>
  <p>Everything is organized by date. Node backups group by date inside each node; panel and Paymenter database backups group by day too — open a day to see its backups.</p>
</header>

<% if (can('run_backups')) { %>
<section class="card">
  <h2><i data-lucide="zap"></i>Manual backup</h2>
  <form method="post" action="/backups/run" class="form-inline">
    <select name="target" onchange="document.getElementById('node-pick').hidden = this.value !== 'node'">
      <option value="all">Everything (nodes + panels + Paymenter)</option>
      <option value="both">Nodes + panel databases</option>
      <option value="nodes">Nodes only (server files)</option>
      <option value="panel">Panel databases only</option>
      <option value="paymenter">Paymenter database only</option>
      <% if (nodes.length) { %><option value="node">A specific node</option><% } %>
    </select>
    <select name="node_id" id="node-pick" hidden>
      <% nodes.forEach(n => { %><option value="<%= n.id %>"><%= n.name %></option><% }) %>
    </select>
    <button class="btn btn-primary" type="submit"><i data-lucide="play"></i>Back up now</button>
  </form>
</section>
<% } %>

<section class="card">
  <h2><i data-lucide="server"></i>Backups per node</h2>
  <p class="muted small">Open a node to see its backup dates and, inside each date, every server that was saved.</p>
  <% if (nodes.length) { %>
  <div class="node-grid">
    <% nodes.forEach(n => { %>
    <a class="node-card" href="/nodes/<%= n.id %>/backups">
      <div class="node-card-head"><i data-lucide="server"></i><span><%= n.name %></span></div>
      <div class="muted small"><%= n.host %></div>
      <div class="node-card-stats">
        <div><span class="muted small">Backup dates</span><b><%= n.snaps %></b></div>
        <div><span class="muted small">Disk</span><b><%= fmtSize(n.total_size) %></b></div>
      </div>
      <div class="muted small">Last: <b><%= n.last_snap || 'Never' %></b></div>
      <span class="node-card-link">View backups <i data-lucide="arrow-right"></i></span>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <p class="empty"><i data-lucide="inbox"></i>No nodes yet. Add them in <a href="/nodes">Pterodactyl</a>.</p>
  <% } %>
</section>


<section class="card">
  <h2><i data-lucide="database"></i>Panel database backups</h2>
  <p class="muted small">Organized by day, like the node backups. Open a day to see every backup taken that date, download, restore or delete them. These backups are independent: restoring node dates never touches the panel database.</p>
  <% if (panelDays.length) { %>
  <div class="node-grid">
    <% panelDays.forEach(d => { %>
    <a class="node-card" href="/db-backups/panel/<%= d.day %>">
      <div class="node-card-head"><i data-lucide="database"></i><span><%= d.day %></span></div>
      <div class="node-card-stats">
        <div><span class="muted small">Backups</span><b><%= d.cnt %></b></div>
        <div><span class="muted small">Disk</span><b><%= fmtSize(d.total_size) %></b></div>
      </div>
      <div class="muted small">Last: <b><%= d.last_at %></b></div>
      <span class="node-card-link">View backups <i data-lucide="arrow-right"></i></span>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <p class="empty"><i data-lucide="inbox"></i>No panel database backups yet.</p>
  <% } %>
</section>

<section class="card">
  <h2><i data-lucide="credit-card"></i>Paymenter database backups</h2>
  <p class="muted small">Organized by day too. Each backup includes the full Paymenter database (mysqldump) plus its <code>.env</code> file. These backups never touch the panel or the nodes.</p>
  <% if (paymenterDays.length) { %>
  <div class="node-grid">
    <% paymenterDays.forEach(d => { %>
    <a class="node-card" href="/db-backups/paymenter/<%= d.day %>">
      <div class="node-card-head"><i data-lucide="credit-card"></i><span><%= d.day %></span></div>
      <div class="node-card-stats">
        <div><span class="muted small">Backups</span><b><%= d.cnt %></b></div>
        <div><span class="muted small">Disk</span><b><%= fmtSize(d.total_size) %></b></div>
      </div>
      <div class="muted small">Last: <b><%= d.last_at %></b></div>
      <span class="node-card-link">View backups <i data-lucide="arrow-right"></i></span>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <p class="empty"><i data-lucide="inbox"></i>No Paymenter backups yet.<% if (!paymenters.length) { %>&nbsp;Add your Paymenter in <a href="/paymenter">Paymenter</a> and use "Back up now" choosing "Paymenter database only".<% } %></p>
  <% } %>
</section>

<%- include('partials/foot') %>
