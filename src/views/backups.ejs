<%- include('partials/head') %>

<header class="page-head">
  <h1>Copias de seguridad</h1>
  <p>Las copias de los nodos están organizadas por fechas dentro de cada nodo. Las de la base de datos de los paneles van por separado.</p>
</header>

<% if (can('run_backups')) { %>
<section class="card">
  <h2><i data-lucide="zap"></i>Copia manual</h2>
  <form method="post" action="/backups/run" class="form-inline">
    <select name="target" onchange="document.getElementById('node-pick').hidden = this.value !== 'node'">
      <option value="both">Todo (nodos + BD de paneles)</option>
      <option value="nodes">Solo nodos (archivos de servidores)</option>
      <option value="panel">Solo BD de los paneles</option>
      <% if (nodes.length) { %><option value="node">Un nodo específico</option><% } %>
    </select>
    <select name="node_id" id="node-pick" hidden>
      <% nodes.forEach(n => { %><option value="<%= n.id %>"><%= n.name %></option><% }) %>
    </select>
    <button class="btn btn-primary" type="submit"><i data-lucide="play"></i>Hacer copia ahora</button>
  </form>
</section>
<% } %>

<section class="card">
  <h2><i data-lucide="server"></i>Copias por nodo</h2>
  <p class="muted small">Pulsa un nodo para ver sus fechas de copia y, dentro de cada fecha, todos los servidores guardados.</p>
  <% if (nodes.length) { %>
  <div class="node-grid">
    <% nodes.forEach(n => { %>
    <a class="node-card" href="/nodes/<%= n.id %>/backups">
      <div class="node-card-head"><i data-lucide="server"></i><span><%= n.name %></span></div>
      <div class="muted small"><%= n.host %></div>
      <div class="node-card-stats">
        <div><span class="muted small">Fechas de copia</span><b><%= n.snaps %></b></div>
        <div><span class="muted small">Espacio</span><b><%= fmtSize(n.total_size) %></b></div>
      </div>
      <div class="muted small">Última: <b><%= n.last_snap || 'Nunca' %></b></div>
      <span class="node-card-link">Ver copias <i data-lucide="arrow-right"></i></span>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <p class="empty"><i data-lucide="inbox"></i>Todavía no hay nodos. Agrégalos en <a href="/nodes">Nodos y Paneles</a>.</p>
  <% } %>
</section>

<section class="card">
  <h2><i data-lucide="database"></i>Copias de la BD de los paneles</h2>
  <p class="muted small">Estas copias van por separado: restaurar fechas de nodos nunca toca la base de datos del panel.</p>
  <% if (panelBackups.length) { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Panel</th><th>Tamaño</th><th>Fecha</th><th>Acciones</th></tr></thead>
      <tbody>
        <% panelBackups.forEach(b => { %>
        <tr>
          <td><span class="badge badge-db"><i data-lucide="database"></i><%= b.panel_name || 'Panel eliminado' %></span></td>
          <td><%= fmtSize(b.size) %></td>
          <td class="muted"><%= b.created_at %></td>
          <td class="row-actions">
            <% if (can('download_backups')) { %>
            <a class="btn btn-sm" href="/backups/<%= b.id %>/download" title="Descargar"><i data-lucide="download"></i></a>
            <% } %>
            <% if (can('restore_backups')) { %>
            <button class="btn btn-sm" type="button" title="Restaurar BD" onclick="openPanelRestore(<%= b.id %>)"><i data-lucide="history"></i></button>
            <% } %>
            <% if (can('delete_backups')) { %>
            <form method="post" action="/backups/<%= b.id %>/delete" class="inline" data-confirm="¿Eliminar esta copia de la base de datos? No se puede deshacer.">
              <button class="btn btn-sm btn-danger" type="submit" title="Eliminar"><i data-lucide="trash-2"></i></button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="empty"><i data-lucide="inbox"></i>Todavía no hay copias de bases de datos.</p>
  <% } %>
</section>

<% if (can('restore_backups') && panelBackups.length) { %>
<dialog id="panel-restore" class="modal">
  <form method="post" action="/restore-panel" class="form">
    <h2><i data-lucide="database"></i>Restaurar base de datos de un panel</h2>
    <label>Copia a restaurar
      <select name="backup_id" id="panel-backup-select">
        <% panelBackups.forEach(b => { %><option value="<%= b.id %>"><%= (b.panel_name || 'Panel eliminado') %> — <%= b.created_at %></option><% }) %>
      </select>
    </label>
    <label>Destino
      <select name="mode" onchange="document.getElementById('custom-target').hidden = this.value !== 'custom'">
        <option value="saved">El panel de esta copia (configuración guardada)</option>
        <option value="custom">Otro VPS (panel nuevo)</option>
      </select>
    </label>
    <div id="custom-target" hidden class="form-grid">
      <label>IP del panel nuevo<input name="host" placeholder="203.0.113.30"></label>
      <label>Puerto SSH<input name="ssh_port" type="number" value="22"></label>
      <label>Usuario SSH<input name="ssh_user" value="root"></label>
      <label>Contraseña SSH<input name="ssh_password" type="password"></label>
      <label>Usuario de la BD<input name="db_user" value="pterodactyl"></label>
      <label>Contraseña de la BD<input name="db_password" type="password"></label>
      <label>Nombre de la BD<input name="db_name" value="panel"></label>
    </div>
    <p class="muted small">El panel destino debe tener Pterodactyl ya instalado (con su base de datos creada). El .zip incluye también el archivo <code>.env</code> original por si necesitas copiarlo a <code>/var/www/pterodactyl/.env</code>.</p>
    <div class="form-actions">
      <button class="btn" type="button" onclick="document.getElementById('panel-restore').close()">Cancelar</button>
      <button class="btn btn-warn" type="submit"><i data-lucide="history"></i>Restaurar base de datos</button>
    </div>
  </form>
</dialog>
<% } %>

<%- include('partials/foot') %>
