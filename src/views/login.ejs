<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Iniciar sesión · PteroBackups</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">
  <div class="login-card">
    <div class="brand login-brand">
      <span class="brand-mark"><i data-lucide="database-backup"></i></span>
      <span class="brand-name">Ptero<b>Backups</b></span>
    </div>
    <p class="login-sub">Sistema de copias de seguridad para Pterodactyl</p>
    <% if (error) { %><div class="alert alert-err"><i data-lucide="alert-triangle"></i><span><%= error %></span></div><% } %>
    <form method="post" action="/login" class="form">
      <label>Correo electrónico
        <input type="email" name="email" required autocomplete="username" placeholder="admin@ejemplo.com">
      </label>
      <label>Contraseña
        <input type="password" name="password" required autocomplete="current-password" placeholder="••••••••">
      </label>
      <button class="btn btn-primary btn-block" type="submit"><i data-lucide="log-in"></i>Entrar</button>
    </form>
    <p class="login-hint">¿Sin cuenta? Pide al administrador que la cree, o crea una raíz desde la consola con <code>npm run create-admin</code>.</p>
  </div>
  <script src="https://unpkg.com/lucide@0.452.0/dist/umd/lucide.min.js"></script>
  <script>lucide.createIcons();</script>
</body>
</html>
