<%- include('partials/head') %>

<%
  // Tres listados posibles: base de datos del panel, base de datos de Paymenter
  // y base de datos + archivos subidos de Paymenter.
  const isFiles = kind === 'paymenter_files';
  const isPay = kind === 'paymenter' || isFiles;
  const payLabel = isFiles ? 'Paymenter database + files' : 'Paymenter database';
%>

<header class="page-head">
  <h1><%= isPay ? payLabel : 'Panel database' %> backups: <%= day %></h1>
  <p>Every <%= isPay ? payLabel.toLowerCase() : 'panel database' %> backup taken on this day. You can download, restore or delete each one. <%= isPay ? 'These backups never touch the panel or the nodes.' : 'Restoring a database never touches the nodes.' %><%= isFiles ? ' Each one also carries the logo, the favicon and the product images uploaded from the panel.' : '' %></p>
</header>

<div class="toolbar">
  <a class="btn" href="/backups"><i data-lucide="arrow-left"></i>Back to Backups</a>
</div>

<section class="card">
  <h2><i data-lucide="<%= isFiles ? 'image' : (isPay ? 'credit-card' : 'database') %>"></i>Backups on <%= day %></h2>
  <% if (backups.length) { %>
  <form method="post" action="/backups/delete-many" class="bulk-form" data-confirm="Delete the selected database backups? This cannot be undone.">
    <% if (can('delete_backups')) { %>
    <div class="bulk-toolbar">
      <button class="btn btn-sm" type="button" onclick="toggleSelectAll(this)"><i data-lucide="check-square"></i><span class="sa-label">Select all</span></button>
      <div class="bulk-bar" hidden>
        <span class="bulk-count"><b>0</b> selected</span>
        <button class="btn btn-sm btn-danger" type="submit"><i data-lucide="trash-2"></i>Delete selected</button>
      </div>
    </div>
    <% } %>
    <div class="table-wrap">
      <table class="bulk-table">
        <thead><tr>
          <% if (can('delete_backups')) { %><th class="col-check"><input type="checkbox" class="bulk-all" title="Select all"></th><% } %>
          <th><%= isPay ? 'Paymenter' : 'Panel' %></th><% if (isPay) { %><th>Contents</th><% } %><th>Size</th><th>Time</th><th>Actions</th>
        </tr></thead>
        <tbody>
          <% backups.forEach(b => { %>
          <tr>
            <% if (can('delete_backups')) { %><td class="col-check"><input type="checkbox" class="bulk-item" name="ids" value="<%= b.id %>"></td><% } %>
            <td><span class="badge <%= isPay ? 'badge-pay' : 'badge-db' %>"><i data-lucide="<%= isFiles ? 'image' : (isPay ? 'credit-card' : 'database') %>"></i><%= b.owner_label || (isPay ? 'Deleted Paymenter' : 'Deleted panel') %></span></td>
            <% if (isPay) { %>
            <%
              let inv = null;
              try { inv = b.manifest ? JSON.parse(b.manifest) : null; } catch (e) { inv = null; }
            %>
            <td>
              <% if (b.has_files) { %>
              <span class="badge badge-full"><i data-lucide="image"></i>Database + files</span>
              <% } else { %>
              <span class="badge"><i data-lucide="database"></i>Database only</span>
              <% } %>
              <% if (inv) { %>
              <div class="muted small pb-inv">
                <%= inv.tables ? inv.tables.length : 0 %> tables<% if (inv.dirs && inv.dirs['storage/app']) { %> · <%= inv.dirs['storage/app'] %> MB of files<% } %><% if (inv.version) { %> · v<%= inv.version %><% } %>
                <% if (inv.extensions && inv.extensions.length) { %>
                <br><span title="Extensions detected when this backup was made: <%= inv.extensions.join(', ') %>. Their tables are inside the backup; the extension itself has to be reinstalled."><i data-lucide="puzzle" style="width:11px;height:11px;vertical-align:-1px"></i> <%= inv.extensions.length %> extensions detected</span>
                <% } %>
              </div>
              <% } %>
            </td>
            <% } %>
            <td><%= fmtSize(b.size) %></td>
            <td class="muted"><%= b.created_at %></td>
            <td class="row-actions">
              <% if (can('download_backups')) { %>
              <a class="btn btn-sm" href="/backups/<%= b.id %>/download" title="Download"><i data-lucide="download"></i></a>
              <% } %>
              <% if (can('restore_backups')) { %>
              <button class="btn btn-sm" type="button" title="Restore this database" onclick="<%= isPay ? 'openPaymenterRestore' : 'openPanelRestore' %>(<%= b.id %>)"><i data-lucide="history"></i></button>
              <% } %>
              <% if (can('delete_backups')) { %>
              <button class="btn btn-sm btn-danger" type="button" title="Delete" onclick="deleteOne(this, '/backups/<%= b.id %>/delete', 'Delete this database backup? This cannot be undone.')"><i data-lucide="trash-2"></i></button>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </form>
  <% } else { %>
  <p class="empty"><i data-lucide="inbox"></i>No backups on this day.</p>
  <% } %>
</section>

<% if (can('restore_backups') && backups.length) { %>
<% if (isPay) { %>
<dialog id="paymenter-restore" class="modal">
  <form method="post" action="/restore-paymenter" class="form">
    <h2><i data-lucide="<%= isFiles ? 'image' : 'credit-card' %>"></i>Restore <%= isFiles ? 'Paymenter (database + files)' : 'a Paymenter database' %></h2>
    <label>Backup to restore
      <select name="backup_id" id="paymenter-backup-select">
        <% backups.forEach(b => { %><option value="<%= b.id %>" data-files="<%= b.has_files ? 1 : 0 %>"><%= (b.owner_label || 'Deleted Paymenter') %> — <%= b.created_at %><%= b.has_files ? ' (database + files)' : ' (database only)' %></option><% }) %>
      </select>
    </label>
    <label>Destination
      <select name="mode" onchange="document.getElementById('paymenter-custom-target').hidden = this.value !== 'custom'">
        <option value="saved">The Paymenter of this backup (saved settings)</option>
        <option value="custom">Another VPS (new Paymenter)</option>
      </select>
    </label>
    <div id="paymenter-custom-target" hidden class="form-grid">
      <label>New VPS IP<input name="host" placeholder="203.0.113.40"></label>
      <label>SSH port<input name="ssh_port" type="number" value="22"></label>
      <label>SSH user<input name="ssh_user" value="root"></label>
      <label>SSH password<input name="ssh_password" type="password"></label>
      <label>Database user<input name="db_user" value="paymenter"></label>
      <label>Database password<input name="db_password" type="password"></label>
      <label>Database name<input name="db_name" value="paymenter"></label>
      <label>Paymenter folder<input name="install_path" value="/var/www/paymenter"></label>
    </div>

    <h3 class="sub-title">What to restore</h3>
    <label class="check-row">
      <input type="checkbox" name="restore_files" value="1" <%= isFiles ? 'checked' : '' %>>
      <span><b>Uploaded files (logo, favicon, product images)</b><br><span class="muted small"><% if (isFiles) { %>Leave it on so you do not have to upload every image again by hand.<% } else { %>These backups are database-only, so there are no files inside them. To bring the images back, restore one from <b>Paymenter database + files</b>.<% } %></span></span>
    </label>
    <label class="check-row">
      <input type="checkbox" name="restore_env" value="1">
      <span><b>Replace the <code>.env</code> file</b><br><span class="muted small">Off by default: on a <b>new</b> VPS the <code>.env</code> holds different database credentials and <code>APP_URL</code>. Turn it on only when restoring onto the <b>same</b> VPS. The current file is saved next to it before being replaced.</span></span>
    </label>

    <p class="muted small">The database is always restored, <b>including the tables added by your extensions</b> — the dump carries every table there is. The extensions themselves have to be reinstalled on the destination VPS, which must already have Paymenter installed with its database created.</p>
    <div class="form-actions">
      <button class="btn" type="button" onclick="document.getElementById('paymenter-restore').close()">Cancel</button>
      <button class="btn btn-warn" type="submit"><i data-lucide="history"></i>Restore Paymenter</button>
    </div>
  </form>
</dialog>
<% } else { %>
<dialog id="panel-restore" class="modal">
  <form method="post" action="/restore-panel" class="form">
    <h2><i data-lucide="database"></i>Restore a panel database</h2>
    <label>Backup to restore
      <select name="backup_id" id="panel-backup-select">
        <% backups.forEach(b => { %><option value="<%= b.id %>"><%= (b.owner_label || 'Deleted panel') %> — <%= b.created_at %></option><% }) %>
      </select>
    </label>
    <label>Destination
      <select name="mode" onchange="document.getElementById('custom-target').hidden = this.value !== 'custom'">
        <option value="saved">The panel of this backup (saved settings)</option>
        <option value="custom">Another VPS (new panel)</option>
      </select>
    </label>
    <div id="custom-target" hidden class="form-grid">
      <label>New panel IP<input name="host" placeholder="203.0.113.30"></label>
      <label>SSH port<input name="ssh_port" type="number" value="22"></label>
      <label>SSH user<input name="ssh_user" value="root"></label>
      <label>SSH password<input name="ssh_password" type="password"></label>
      <label>Database user<input name="db_user" value="pterodactyl"></label>
      <label>Database password<input name="db_password" type="password"></label>
      <label>Database name<input name="db_name" value="panel"></label>
    </div>
    <p class="muted small">The destination panel must already have Pterodactyl installed (with its database created). The .zip also includes the original <code>.env</code> file in case you need to copy it to <code>/var/www/pterodactyl/.env</code>.</p>
    <div class="form-actions">
      <button class="btn" type="button" onclick="document.getElementById('panel-restore').close()">Cancel</button>
      <button class="btn btn-warn" type="submit"><i data-lucide="history"></i>Restore database</button>
    </div>
  </form>
</dialog>
<% } %>
<% } %>

<%- include('partials/foot') %>
