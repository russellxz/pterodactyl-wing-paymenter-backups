<%- include('partials/head') %>

<header class="page-head">
  <h1>Home</h1>
  <p>Overview of your backup system.</p>
</header>

<section class="stats-grid">
  <div class="card stat">
    <i data-lucide="server"></i>
    <div><span class="stat-num"><%= stats.nodes %></span><span class="stat-label">Nodes</span></div>
  </div>
  <div class="card stat">
    <i data-lucide="database"></i>
    <div><span class="stat-num"><%= stats.panels %></span><span class="stat-label">Panels</span></div>
  </div>
  <div class="card stat">
    <i data-lucide="credit-card"></i>
    <div><span class="stat-num"><%= stats.paymenters %></span><span class="stat-label">Paymenter</span></div>
  </div>
  <div class="card stat">
    <i data-lucide="archive"></i>
    <div><span class="stat-num"><%= stats.backups %></span><span class="stat-label">Stored backups</span></div>
  </div>
  <div class="card stat">
    <i data-lucide="hard-drive"></i>
    <div><span class="stat-num"><%= fmtSize(stats.size) %></span><span class="stat-label">Disk used</span></div>
  </div>
  <div class="card stat">
    <i data-lucide="clock"></i>
    <div><span class="stat-num stat-small"><%= stats.last ? stats.last.created_at : 'Never' %></span><span class="stat-label">Last backup</span></div>
  </div>
</section>

<% if (can('run_backups')) { %>
<section class="card">
  <h2><i data-lucide="zap"></i>Manual backup</h2>
  <p class="muted">Run a backup right now, without waiting for the automatic schedule.</p>
  <form method="post" action="/backups/run" class="form-inline">
    <select name="target" id="target-select" onchange="document.getElementById('node-pick').hidden = this.value !== 'node'">
      <option value="all">Everything (nodes + panels + Paymenter)</option>
      <option value="both">Nodes + panel databases</option>
      <option value="nodes">Nodes only (server files)</option>
      <option value="panel">Panel databases only</option>
      <option value="paymenter">Paymenter database only</option>
      <% if (nodes.length) { %><option value="node">A specific node</option><% } %>
    </select>
    <select name="node_id" id="node-pick" hidden>
      <% nodes.forEach(n => { %><option value="<%= n.id %>"><%= n.name %></option><% }) %>
    </select>
    <button class="btn btn-primary" type="submit"><i data-lucide="play"></i>Back up now</button>
  </form>
</section>
<% } %>

<% if (stats.panels === 0 || stats.nodes === 0) { %>
<section class="card guide">
  <h2><i data-lucide="compass"></i>First steps</h2>
  <ol class="guide-list">
    <li><i data-lucide="database"></i><div><b>Add your Pterodactyl panel (you can have several).</b> In <a href="/nodes">Pterodactyl</a>, enter the IP of the VPS where the panel is installed, its SSH password and the database details (user, password and name, usually <code>pterodactyl</code> / <code>panel</code>; they are in the panel's <code>/var/www/pterodactyl/.env</code> file).</div></li>
    <li><i data-lucide="server"></i><div><b>Add your nodes (Wings)</b> with their IP and SSH password, choosing which panel each one belongs to. Remember to install <code>zip</code> and <code>unzip</code> on every node: <code>sudo apt update && sudo apt install -y zip unzip</code>.</div></li>
    <li><i data-lucide="credit-card"></i><div><b>Using Paymenter?</b> Add it in <a href="/paymenter">Paymenter</a> with its VPS IP, SSH password and database details (they are in <code>/var/www/paymenter/.env</code>). Its backups run separately, on their own timer.</div></li>
    <li><i data-lucide="settings"></i><div><b>Schedule the backups.</b> In <a href="/settings">Settings</a>, choose how often automatic backups run (1 hour, 1, 7, 15 or 30 days) and when old backups get deleted.</div></li>
    <li><i data-lucide="play"></i><div><b>Run your first backup.</b> Each run creates a "backup date" inside every node: in <a href="/backups">Backups</a>, open the node, pick the date, and you'll find every server there ready to download or restore.</div></li>
  </ol>
</section>
<% } else { %>
<section class="card">
  <h2><i data-lucide="calendar-clock"></i>Current schedule</h2>
  <% const fmtSched = (h) => h == 0 ? 'Disabled' : (h == 1 ? 'Every hour' : 'Every ' + (h / 24) + ' day(s)'); %>
  <div class="kv">
    <div><span class="muted">Node backups:</span> <b><%= fmtSched(stats.scheduleHoursNodes) %></b></div>
    <div><span class="muted">Panel database backups:</span> <b><%= fmtSched(stats.scheduleHoursPanel) %></b></div>
    <div><span class="muted">Paymenter database backups:</span> <b><%= fmtSched(stats.scheduleHoursPaymenter) %></b></div>
    <div><span class="muted">Paymenter database + files backups:</span> <b><%= fmtSched(stats.scheduleHoursPaymenterFiles) %></b></div>
    <div><span class="muted">Old backup cleanup:</span> <b><%= stats.retentionHours == 0 ? 'Never' : 'Older than ' + (stats.retentionHours >= 24 ? (stats.retentionHours / 24) + ' day(s)' : stats.retentionHours + ' hour(s)') %></b></div>
  </div>
  <p class="muted small">When automatic backups are enabled, the countdowns above show how long is left for each one (nodes, panel and Paymenter).</p>
</section>
<% } %>

<%- include('partials/foot') %>
